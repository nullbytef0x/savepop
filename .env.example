# Internal address used by the API container when creating download tunnels.
# The default compose network resolves the "api" hostname automatically.
SAVEPOP_API_URL=http://api:5120/

# Browser-facing API path. The web container proxies this path to the API, so
# it works on localhost, a VPS IP, or an HTTPS domain without changing it.
SAVEPOP_WEB_API_URL=/api/

# Public hostname used for generated sitemap URLs (without http:// or https://).
WEB_HOST=localhost:5173
